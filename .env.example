# CareSync Core Environment Configuration

ENVIRONMENT=development

# Database Settings (PostgreSQL container inside Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword2026
POSTGRES_DB=caresync_db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword2026@caresync-postgres:5432/caresync_db

# Redis Settings
REDIS_URL=redis://caresync-redis:6379/0

# Security & Auth
JWT_SECRET=caresync-secret-key-change-in-production-2026

# Background Worker & Agent
WORKER_POLL_INTERVAL_SECONDS=2
AGENT_ENABLED=true

# CareSync Core Environment Configuration
# Copy to .env and replace every <placeholder>. Never commit real values.

# development | test run locally; any other value (e.g. prod) enforces production safeguards.
ENVIRONMENT=development
AWS_REGION=ap-south-1

# Database Settings (PostgreSQL container inside Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<local-postgres-password>
POSTGRES_DB=caresync_db
DATABASE_URL=postgresql+asyncpg://postgres:<local-postgres-password>@caresync-postgres:5432/caresync_db

# Redis Settings
REDIS_URL=redis://caresync-redis:6379/0

# Security & Auth
# Required outside development/test: the API refuses to start with the built-in dev secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-long-random-secret>

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Background Worker & Agent
WORKER_POLL_INTERVAL_SECONDS=2
AGENT_ENABLED=true

# Destructive demo reset: admin-only, local environments only. Leave false unless running a local demo.
DEMO_RESET_ENABLED=false
